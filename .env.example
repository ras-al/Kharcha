# Copy to .env and paste the values from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use local Firebase emulators (npm run emulators) instead of the real project.
VITE_USE_EMULATORS=false

# Optional. reCAPTCHA Enterprise site key that turns on Firebase App Check (bot protection).
VITE_RECAPTCHA_SITE_KEY=

# Optional. Public address for social previews, sitemap and robots.txt.
# Defaults to https://<project-id>.web.app
VITE_SITE_URL=
